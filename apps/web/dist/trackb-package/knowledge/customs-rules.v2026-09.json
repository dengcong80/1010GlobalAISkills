{
  "version": "CUSTOMS-2026.09",
  "sourceIds": ["nz-customs-tariff", "nz-customs-export", "nz-customs-tsw", "nz-mfat-fta-guide"],
  "rules": [
    {"id": "CUS-HS-CANDIDATE", "when": "product matches honey or manuka", "then": "propose 0409.00 candidates", "implementation": "hsCandidatesFor", "test": "honey HS candidate"},
    {"id": "CUS-LIVE-SOURCE-HASH", "when": "liveSourceLookup=true", "then": "fetch, inspect marker, hash response and retain status", "implementation": "fetchOfficialTariffSource", "test": "source snapshot"},
    {"id": "CUS-DRAFT-ONLY", "when": "documents are generated", "then": "TSW_DRAFT with submission=DRAFT_ONLY", "implementation": "createDocuments", "test": "no TSW submission"},
    {"id": "CUS-RATE-ASSUMPTION", "when": "duty, levy or GST rates are case supplied", "then": "show transparent estimate and assumption", "implementation": "runCustomsSkill", "test": "landed value"},
    {"id": "CUS-FAIL-CLOSED", "when": "source unavailable, lines invalid or parties missing", "then": "REVIEW or BLOCKED with validation issue", "implementation": "runCustomsSkill", "test": "invalid customs fallback"}
  ],
  "limitations": ["HS codes, rates and preferential treatment remain candidates until a broker or current tariff confirms them.", "The system never submits to TSW."]
}
